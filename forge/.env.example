NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_PERSONA_MODEL=
NVIDIA_BASE_MODEL=meta/llama-4-maverick-17b-128e-instruct
NVIDIA_EMBEDDING_MODEL=nvidia/llama-3.2-nv-embedqa-1b-v2
WHISPER_MODEL_SIZE=base  # "base" is faster for dev; "large-v3" is best quality for production
# Local dev: set to "true" to skip AWS infra. No credentials needed.
USE_LOCAL_STORAGE=true
USE_LOCAL_RAG=true
# REQUIRED for fine-tuning; copy from the NVIDIA NGC dashboard.
NVIDIA_CUSTOMIZATION_BASE_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_S3_BUCKET=
AWS_RDS_HOST=
AWS_RDS_PORT=5432
AWS_RDS_DB=forge
AWS_RDS_USER=forge
AWS_RDS_PASSWORD=forge
AWS_ECS_CLUSTER=
AWS_ECS_TASK_DEFINITION=
DAILY_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
# ElevenLabs Rachel/free default voice.
ATTACKER_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Optional: override ElevenLabs voice for Twilio phone calls.
# Falls back to the voice cloned from the build pipeline.
TWILIO_VOICE_ID=
# Required for speaker diarization. Accept pyannote/speaker-diarization-3.1 terms at hf.co first.
HUGGINGFACE_TOKEN=
CEKURA_API_KEY=
CEKURA_BASE_URL=
# Use http://localhost:8000 for local dev without docker compose.
PERSONA_AGENT_URL=http://backend:8000
