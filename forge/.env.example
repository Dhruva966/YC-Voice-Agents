# ─── REQUIRED: Core API Keys ───────────────────────────────────────────────────
# Google AI Studio → https://aistudio.google.com/apikey
# Used for: Gemini 3.1 Flash Live (voice pipeline — STT + LLM + TTS in one model)
GEMINI_API_KEY=

# NVIDIA NIM → https://build.nvidia.com/
# Used for: transcript scoring, RAG embeddings, LoRA fine-tuning, personality extraction
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_BASE_MODEL=meta/llama-4-maverick-17b-128e-instruct
NVIDIA_EMBEDDING_MODEL=nvidia/llama-3.2-nv-embedqa-1b-v2

# Daily.co → https://dashboard.daily.co/developers
# Used for: WebRTC rooms (persona bot + Vanguard attacker sessions)
DAILY_API_KEY=

# Twilio → https://console.twilio.com/
# Used for: inbound phone call handling (Twilio → WebSocket → Gemini Live)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# Optional explicit Twilio Media Stream URL. Must be wss://.../media-stream.
TWILIO_STREAM_URL=

# Cekura → https://cekura.ai (evaluation API)
# Falls back to NVIDIA NIM rubric scoring if not set
CEKURA_API_KEY=
CEKURA_BASE_URL=

# ─── OPTIONAL: Voice & Fine-tune ──────────────────────────────────────────────
# Gemini voice for persona bot. Options: Puck, Charon, Kore, Fenrir, Aoede
GEMINI_VOICE=Puck

# Legacy Vanguard attacker audio path. The persona pipeline uses Gemini Live,
# but attacker_bot.py currently still imports Deepgram STT + ElevenLabs TTS.
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
ATTACKER_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# NVIDIA LoRA customization endpoint (only needed to submit real fine-tune jobs)
NVIDIA_CUSTOMIZATION_BASE_URL=

# Filled automatically after fine-tune completes
NVIDIA_PERSONA_MODEL=

# ─── LOCAL DEV (safe defaults) ────────────────────────────────────────────────
USE_LOCAL_STORAGE=true
USE_LOCAL_RAG=true

# Whisper model: base (fast, ~74MB) for dev; large-v3 (best quality) for prod
WHISPER_MODEL_SIZE=base

# Number of transcript segments to select as golden fine-tune training data
TRANSCRIPT_SCORE_TOP_K=50

# Backend URL for Vanguard sessions. localhost for local; http://backend:8000 for Docker
PERSONA_AGENT_URL=http://localhost:8000

# ─── AWS (only when USE_LOCAL_STORAGE=false) ──────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=

# ─── HUGGING FACE (optional — better speaker diarization) ─────────────────────
# Accept pyannote/speaker-diarization-3.1 terms at hf.co/pyannote first
HUGGINGFACE_TOKEN=
