# ─── REQUIRED: Core API Keys ───────────────────────────────────────────────────
# Google AI Studio → https://aistudio.google.com/apikey
# Used for: Gemini 3.1 Flash Live (voice pipeline — STT + LLM + TTS in one model)
GEMINI_API_KEY=

# NVIDIA NIM → https://build.nvidia.com/
# Used for: transcript scoring, RAG embeddings, LoRA fine-tuning, personality extraction
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_BASE_MODEL=meta/llama-4-maverick-17b-128e-instruct
NVIDIA_EMBEDDING_MODEL=nvidia/llama-nemotron-embed-1b-v2
NVIDIA_EMBEDDING_DIMENSIONS=1024

# Daily.co → https://dashboard.daily.co/developers
# Used for: WebRTC rooms (persona bot + Vanguard attacker sessions)
DAILY_API_KEY=

# Twilio → https://console.twilio.com/
# Used for: inbound phone call handling (Twilio → WebSocket → Gemini Live)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# Optional explicit Twilio Media Stream URL. Must be wss://.../media-stream.
TWILIO_STREAM_URL=

# Cekura → https://cekura.ai (evaluation API)
# Falls back to NVIDIA NIM rubric scoring if not set
CEKURA_API_KEY=
CEKURA_BASE_URL=
# Cekura agent ID for the persona agent — get from aiagents_create or Cekura dashboard.
# When set, every Vanguard session transcript is posted to Cekura observability.
CEKURA_AGENT_ID=

# ─── OPTIONAL: Voice & Fine-tune ──────────────────────────────────────────────
# Gemini Live model and voices. Options include: Puck, Charon, Kore, Fenrir, Aoede
GEMINI_MODEL=gemini-3.1-flash-live-preview
GEMINI_VOICE=Puck
ATTACKER_GEMINI_VOICE=Charon

# Legacy voice clone helper only. Persona + Vanguard runtime use Gemini Live.
ELEVENLABS_API_KEY=

# NVIDIA LoRA customization endpoint (only needed to submit real fine-tune jobs)
NVIDIA_CUSTOMIZATION_BASE_URL=

# Optional adapter ID saved/displayed after fine-tune completes; Gemini Live does not load it.
NVIDIA_PERSONA_MODEL=

# Maximum time to wait for a customization job before falling back to the base runtime.
FINETUNE_MAX_WAIT_SECONDS=3600

# ─── LOCAL DEV (safe defaults) ────────────────────────────────────────────────
USE_LOCAL_STORAGE=true
USE_LOCAL_RAG=true

# Whisper model: base (fast, ~74MB) for dev; large-v3 (best quality) for prod
WHISPER_MODEL_SIZE=base

# Number of transcript segments to select as golden fine-tune training data
TRANSCRIPT_SCORE_TOP_K=50

# Backend URL for Vanguard sessions. localhost for local; http://backend:8000 for Docker
PERSONA_AGENT_URL=http://localhost:8000

# Max number of attack variants in the suite (grows with improvement cycles)
MAX_ATTACK_SUITE_SIZE=50

# Comma-separated CORS origins for the frontend. MUST be explicit (never *) in production.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Frontend API base URL — baked into Next.js at build time (NEXT_PUBLIC_ prefix required).
# Set to your public backend URL when deploying (e.g. https://api.myforge.example.com).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Explicit Twilio WebSocket stream URL. If unset, derived from request host headers.
# Set this in production to avoid host-header spoofing. Must be wss://.
# TWILIO_STREAM_URL=wss://your-ngrok-url.ngrok.io/media-stream
# WSS_BASE_URL=  (legacy alias for TWILIO_STREAM_URL — prefer TWILIO_STREAM_URL)

# Optional: override local storage root and ChromaDB directory.
# LOCAL_DATA_DIR=./local_data
# LOCAL_CHROMA_DIR=./local_data/chroma

# Local pgvector/Postgres defaults. Used by docker-compose and by RDS when
# USE_LOCAL_RAG=false. docker-compose overrides AWS_RDS_HOST to postgres.
AWS_RDS_HOST=localhost
AWS_RDS_PORT=5432
AWS_RDS_DB=forge
AWS_RDS_USER=forge
AWS_RDS_PASSWORD=forge

# ─── AWS (only when USE_LOCAL_STORAGE=false) ──────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=

# ─── HUGGING FACE (optional — better speaker diarization) ─────────────────────
# Accept pyannote/speaker-diarization-3.1 terms at hf.co/pyannote first
HUGGINGFACE_TOKEN=
