# REQUIRED: Core API keys

# Google AI Studio: https://aistudio.google.com/apikey
# Used for Gemini 3.1 Flash Live voice pipelines.
GEMINI_API_KEY=

# NVIDIA NIM: https://build.nvidia.com/
# Used for transcript scoring, RAG embeddings, LoRA fine-tuning, and personality extraction.
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_BASE_MODEL=meta/llama-4-maverick-17b-128e-instruct
NVIDIA_EMBEDDING_MODEL=nvidia/llama-nemotron-embed-1b-v2
NVIDIA_EMBEDDING_DIMENSIONS=1024

# Daily: https://dashboard.daily.co/developers
# Used for WebRTC rooms for browser calls and Vanguard attacker sessions.
DAILY_API_KEY=

# Twilio: https://console.twilio.com/
# Used for PSTN phone calls into the Gemini Live media-stream pipeline.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Optional Cekura observability. NVIDIA NIM drives Vanguard pass/fail scoring.
CEKURA_API_KEY=
CEKURA_BASE_URL=https://api.cekura.ai
# Cekura agent ID for the persona agent, from the Cekura dashboard.
CEKURA_AGENT_ID=


# OPTIONAL: Voice and fine-tune

# Gemini Live model and voices. Voice options include Puck, Charon, Kore, Fenrir, Aoede.
GEMINI_MODEL=gemini-3.1-flash-live-preview
GEMINI_VOICE=Puck
ATTACKER_GEMINI_VOICE=Charon

# Legacy voice clone helper only. Persona and Vanguard runtime use Gemini Live.
ELEVENLABS_API_KEY=

# NVIDIA LoRA customization endpoint. Only needed to submit real fine-tune jobs.
NVIDIA_CUSTOMIZATION_BASE_URL=
# Max seconds to wait for a fine-tune job before falling back.
FINETUNE_MAX_WAIT_SECONDS=3600

# Filled automatically after fine-tune completes. Gemini Live does not load it today.
NVIDIA_PERSONA_MODEL=


# LOCAL DEV

USE_LOCAL_STORAGE=true
USE_LOCAL_RAG=true

# Whisper model: base for dev; large-v3 for better transcription quality.
WHISPER_MODEL_SIZE=base

# Number of transcript segments to select as golden fine-tune training data.
TRANSCRIPT_SCORE_TOP_K=50

# Backend URL for Vanguard sessions. Use http://backend:8000 for Docker.
PERSONA_AGENT_URL=http://localhost:8000

# Max number of attack variants in the suite as improvement cycles append harder variants.
MAX_ATTACK_SUITE_SIZE=50

# Optional shared API key. When set, non-webhook HTTP endpoints require X-API-Key.
# This is useful for demos, but production still needs real tenant auth/authorization.
# FORGE_API_KEY=

# Optional browser-visible demo copy of FORGE_API_KEY for the Next.js dashboard.
# This is not a production auth boundary because NEXT_PUBLIC_* is exposed to users.
# NEXT_PUBLIC_FORGE_API_KEY=

# Comma-separated CORS origins for the frontend. Must be explicit; never use * in production.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Frontend API base URL, baked into Next.js at build time.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Explicit Twilio WebSocket stream URL. If unset, derived from request host headers.
# Set in production to avoid host-header spoofing. Must be wss://.
# /media-stream URLs are HMAC-signed with MEDIA_STREAM_SECRET or TWILIO_AUTH_TOKEN.
# MEDIA_STREAM_SECRET=
# TWILIO_STREAM_URL=wss://your-ngrok-url.ngrok.io/media-stream
# WSS_BASE_URL=  (legacy alias for TWILIO_STREAM_URL; prefer TWILIO_STREAM_URL)

# Optional local storage and ChromaDB directories.
# LOCAL_DATA_DIR=./local_data
# LOCAL_CHROMA_DIR=./local_data/chroma


# Local pgvector/Postgres defaults. Used by docker-compose and by RDS when
# USE_LOCAL_RAG=false. docker-compose overrides AWS_RDS_HOST to postgres.
AWS_RDS_HOST=localhost
AWS_RDS_PORT=5432
AWS_RDS_DB=forge
AWS_RDS_USER=forge
AWS_RDS_PASSWORD=forge


# AWS, only when USE_LOCAL_STORAGE=false

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=


# Hugging Face, optional for better speaker diarization

# Accept pyannote/speaker-diarization-3.1 terms at hf.co/pyannote first.
HUGGINGFACE_TOKEN=
